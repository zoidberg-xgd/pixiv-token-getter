{
  "name": "pixiv-token-getter",
  "version": "2.3.0",
  "description": "Get Pixiv API access & refresh tokens from Node.js - library and CLI (ptg) with PKCE OAuth login (interactive or headless). TypeScript types included.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./lib": {
      "require": "./lib/index.js",
      "types": "./index.d.ts"
    },
    "./cli": "./cli.js"
  },
  "bin": {
    "pixiv-token-getter": "cli.js",
    "ptg": "cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "interactive": "node cli.js --interactive",
    "headless": "node cli.js --headless",
    "example": "node examples/basic-usage.js"
  },
  "keywords": [
    "pixiv",
    "token",
    "puppeteer",
    "login",
    "oauth",
    "cli",
    "authentication",
    "api",
    "sdk",
    "pixiv-api"
  ],
  "author": "redtidev1918",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redtidev1918/pixiv-token-getter.git"
  },
  "bugs": {
    "url": "https://github.com/redtidev1918/pixiv-token-getter/issues"
  },
  "homepage": "https://github.com/redtidev1918/pixiv-token-getter#readme",
  "sideEffects": false,
  "dependencies": {
    "puppeteer": "^25.9.0",
    "axios": "^1.6.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib/",
    "cli.js",
    "index.js",
    "index.d.ts",
    "README.md",
    "examples/"
  ]
}
